<Window x:Class="Research_Author_Publication_Data.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Research_Author_Publication_Data"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0 10 0 0" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Directory"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="10 0 10 0"
                               Grid.Column="0" />

                    <TextBox materialDesign:HintAssist.Hint="Select Input Directory"
                             Grid.Column="1"
                             Margin="0,5,0,5"
                             Text="{Binding DirectoryPath}"
                             IsReadOnly="True" />

                    <Button Content="Select"
                            Width="90"
                            Grid.Column="2"
                            Command="{Binding SelectDirectoryCommand}"
                            Margin="10 0 10 0" />
                </Grid>

                <Grid Margin="0 5 0 0" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Output File"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="10 0 10 0"
                               Grid.Column="0" />

                    <TextBox materialDesign:HintAssist.Hint="Select Output File Path"
                             Grid.Column="1"
                             Margin="0,5,0,5"
                             Text="{Binding OutputFilePath}"
                             IsReadOnly="True" />

                    <Button Content="Select"
                            Width="90"
                            Grid.Column="2"
                            Command="{Binding SelectOutputFileCommand}"
                            Margin="10 0 10 0" />
                </Grid>

                <Grid Margin="0 5 0 0" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Header"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="10 0 10 0"
                               Grid.Column="0" />

                    <CheckBox Grid.Column="1"
                              Margin="0,5,0,5"
                              IsChecked="{Binding HasHeader}"
                              Content="Has Header Row" />
                </Grid>

                <GroupBox Grid.Row="3"
                          Header="Parsing Options"
                          Margin="10 5 10 5">
                    <Grid Margin="0 4 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Authors Column"
                                   VerticalAlignment="Center"
                                   Margin="5 3 10 3" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 materialDesign:HintAssist.Hint="Column header name, e.g. Authors or AF"
                                 Text="{Binding AuthorColumnHeader, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 3 5 3" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Author Separator"
                                   VerticalAlignment="Center"
                                   Margin="5 3 10 3" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 materialDesign:HintAssist.Hint="Separator between authors, e.g. , or ;"
                                 Text="{Binding AuthorSeparator, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 3 5 3" />

                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="Names are in Last, First format"
                                  IsChecked="{Binding NamesAreLastFirst}"
                                  Margin="5 3 5 3" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="4"
                          Header="Output Columns"
                          Margin="10 5 10 5">
                    <Grid Margin="0 4 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0"
                                  Content="First Author"
                                  IsChecked="{Binding IncludeFirst}"
                                  VerticalAlignment="Center"
                                  Margin="5 3 10 3" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding FirstLabel, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IncludeFirst}"
                                 Margin="0 3 5 3" />

                        <CheckBox Grid.Row="1" Grid.Column="0"
                                  Content="Middle Author"
                                  IsChecked="{Binding IncludeMiddle}"
                                  VerticalAlignment="Center"
                                  Margin="5 3 10 3" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding MiddleLabel, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IncludeMiddle}"
                                 Margin="0 3 5 3" />

                        <CheckBox Grid.Row="2" Grid.Column="0"
                                  Content="Last Author"
                                  IsChecked="{Binding IncludeLast}"
                                  VerticalAlignment="Center"
                                  Margin="5 3 10 3" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding LastLabel, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IncludeLast}"
                                 Margin="0 3 5 3" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="5"
                          Header="Analytical Options"
                          Margin="10 0 10 5">
                    <WrapPanel Margin="5 4 5 4">
                        <CheckBox Content="Total"
                                  IsChecked="{Binding IncludeTotal}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 20 0" />
                        <CheckBox Content="Percentages"
                                  IsChecked="{Binding IncludePercentages}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 20 0" />
                        <CheckBox Content="Summary Row"
                                  IsChecked="{Binding IncludeSummaryRow}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 20 0" />
                        <CheckBox Content="Solo Author Count"
                                  IsChecked="{Binding IncludeSoloCount}"
                                  VerticalAlignment="Center" />
                    </WrapPanel>
                </GroupBox>

                <Grid Margin="0 8 0 8" Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Start"
                                Width="90"
                                Command="{Binding StartCommand}"
                                Margin="0 0 5 0" />
                        <Button Content="Stop"
                                Width="90"
                                Command="{Binding StopCommand}"
                                Margin="5 0 0 0" />
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>

        <ProgressBar Grid.Row="1"
                     Margin="10 4 10 4"
                     Height="8"
                     VerticalAlignment="Center"
                     Minimum="0"
                     Maximum="{Binding TotalFiles}"
                     Value="{Binding Progress}" />

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" />
                    <Border Margin="5,0,5,0"
                            BorderBrush="#FFD4D4D4"
                            BorderThickness="1" />
                    <TextBlock Text="{Binding StatusChecked}" />
                    <Border Margin="5,0,5,0"
                            BorderBrush="#FFD4D4D4"
                            BorderThickness="1" />
                    <TextBlock Text="{Binding StatusFile}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
